apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ ocp_cluster.name }}-manual-creds
  namespace: {{ ocp_cluster.name }}
data:
{% for f in cred_request_files.files %}
{% set cr = lookup('file', f.path) | from_yaml %}
{# Feature-gated CredentialsRequests (e.g. the cluster-api provider's, in
   namespace openshift-cluster-api) target namespaces never created on a
   default-featureSet cluster. Including their Secret here wedges
   cluster-bootstrap's asset loop forever ("namespaces ... not found"),
   which keeps the bootstrap node's MCS alive and starves workers whose
   ignition requests land on it instead of a master.
   The payload has used both `release.openshift.io/feature-gate` (older
   releases) and `release.openshift.io/feature-set` (confirmed live on
   4.20.43) to mark these -- checking only the former let the 4.20 CAPA
   CredentialsRequest (feature-set: CustomNoUpgrade,TechPreviewNoUpgrade)
   through and wedged a spoke's bootstrap the same way it once did the
   hub's (see roles/ocp/create_manual_cloud_credentials, fixed the same
   way). Match either annotation key. #}
{% if not (cr.metadata.annotations | default({}) | list | select('match', '^release\.openshift\.io/feature-(gate|set)$') | list) %}
  {{ cr.spec.secretRef.namespace }}-{{ cr.spec.secretRef.name }}-credentials.yaml: |
    apiVersion: v1
    kind: Secret
    metadata:
      name: {{ cr.spec.secretRef.name }}
      namespace: {{ cr.spec.secretRef.namespace }}
    type: Opaque
    stringData:
      aws_access_key_id: {{ aws.aws_access_key_id }}
      aws_secret_access_key: {{ aws.aws_secret_access_key }}
{% endif %}
{% endfor %}
{# Neither route53.amazonaws.com nor tagging.us-east-1.amazonaws.com has an
   interface VPC endpoint in any commercial AWS region, so the in-cluster
   ingress operator can never manage *.apps itself from the isolated Cluster
   VPC — it fails forever with "NoZones". aws/create_apps_wildcard_dns_record
   creates the record instead from the jumphost; this just stops the operator
   from trying. Hive's manifestsConfigMapRef only takes one ConfigMap, so this
   rides along with the credential Secrets above rather than a separate one. #}
{% if disconnected.network_lockdown.enabled | default(true) %}
  cluster-ingress-default-ingresscontroller.yaml: |
    apiVersion: operator.openshift.io/v1
    kind: IngressController
    metadata:
      name: default
      namespace: openshift-ingress-operator
    spec:
      domain: apps.{{ ocp_cluster.name }}.{{ base_domain }}
      endpointPublishingStrategy:
        type: LoadBalancerService
        loadBalancer:
          scope: Internal
          dnsManagementPolicy: Unmanaged
{% endif %}
