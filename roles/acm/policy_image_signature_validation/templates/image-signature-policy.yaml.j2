---
# Allows the policy namespace to see clusters in the target set
apiVersion: cluster.open-cluster-management.io/v1beta2
kind: ManagedClusterSetBinding
metadata:
  name: "{{ spokes_clusterset }}"
  namespace: {{ image_policy_namespace }}
spec:
  clusterSet: "{{ spokes_clusterset }}"

---
apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: image-signature-placement
  namespace: {{ image_policy_namespace }}
spec:
  clusterSets:
    - "{{ spokes_clusterset }}"

---
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: enforce-image-signature-validation
  namespace: {{ image_policy_namespace }}
  annotations:
    policy.open-cluster-management.io/standards: Configuration Baseline
    policy.open-cluster-management.io/categories: SI System and Information Integrity
spec:
  remediationAction: {{ policy_remediation_action }}
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: image-signature-validation-config
        spec:
          remediationAction: {{ policy_remediation_action }}
          severity: high
          namespaceSelector:
            include:
{% for ns in validated_namespaces %}
              - "{{ ns }}"
{% endfor %}
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: policy.sigstore.dev/v1alpha1
                kind: ImagePolicy
                metadata:
                  name: image-signature-policy
                spec:
                  scopes:
{% for scope in signed_image_scopes %}
                    - "{{ scope }}"
{% endfor %}
                  authorities:
                    - key:
                        data: "{{ signing_public_key_data }}"
                      ctlog:
                        url: "{{ sigstore_rekor_url }}"
{% if excluded_images | length > 0 %}
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: image-signature-exclusions-config
        spec:
          remediationAction: {{ policy_remediation_action }}
          severity: low
          namespaceSelector:
            include:
{% for ns in validated_namespaces %}
              - "{{ ns }}"
{% endfor %}
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: policy.sigstore.dev/v1alpha1
                kind: ImagePolicy
                metadata:
                  name: image-signature-exclusions
                spec:
                  scopes:
{% for image in excluded_images %}
                    - "{{ image }}"
{% endfor %}
                  authorities:
                    - static:
                        action: pass
{% endif %}

---
apiVersion: policy.open-cluster-management.io/v1beta1
kind: PolicySet
metadata:
  name: image-signature-policies
  namespace: {{ image_policy_namespace }}
spec:
  description: "Enforces image signature validation for managed cluster workloads"
  policies:
    - enforce-image-signature-validation

---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: image-signature-placement-binding
  namespace: {{ image_policy_namespace }}
placementRef:
  apiGroup: cluster.open-cluster-management.io
  kind: Placement
  name: image-signature-placement
subjects:
  - apiGroup: policy.open-cluster-management.io
    kind: PolicySet
    name: image-signature-policies
