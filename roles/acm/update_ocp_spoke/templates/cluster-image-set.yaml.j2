apiVersion: hive.openshift.io/v1
kind: ClusterImageSet
metadata:
  name: img{{ openshift_version }}.{{ ocp_patch_version }}-x86-64-appsub
  labels:
    channel: stable
    visible: "true"
spec:
  # Confirmed live against the real Quay layout post-migrate_mirror: oc-mirror v2
  # pushes the release image under openshift/release-images, not
  # openshift-release-dev/ocp-release (the cluster's own idms-release-0-quay
  # IDMS maps quay.io/openshift-release-dev/ocp-release -> .../openshift/release-images).
  releaseImage: {{ quay_registry_url }}/{{ quay_mirror_org }}/openshift/release-images:{{ openshift_version }}.{{ ocp_patch_version }}-x86_64
