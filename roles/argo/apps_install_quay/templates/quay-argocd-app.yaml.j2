apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ quay_argocd_app_name }}
  namespace: {{ quay_argocd_namespace }}
spec:
  project: {{ quay_argocd_project }}
  source:
    repoURL: {{ quay_git_repo_url }}
    targetRevision: '{{ quay_git_repo_revision }}'
    path: {{ quay_git_repo_path }}
    directory:
      recurse: true
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ quay_target_namespace }}
  syncPolicy:
{% if quay_argocd_sync_policy == "Automatic" %}
    automated:
      prune: true
      selfHeal: true
{% endif %}
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      # ignoreDifferences only hides a field from diff/OutOfSync computation —
      # it does NOT stop a sync from overwriting it. Confirmed live: without
      # this, a sync reverted ocp/configure_quay_mirror's in-place edit to
      # init-config-bundle-secret (adding DISTRIBUTED_STORAGE_CONFIG) 2
      # seconds after it was applied, even with that secret already listed in
      # ignoreDifferences below.
      - RespectIgnoreDifferences=true
    retry:
      limit: 5
      backoff:
        duration: 30s
        factor: 2
        maxDuration: 3m
  ignoreDifferences:
    - group: quay.redhat.com
      kind: QuayRegistry
      jsonPointers:
        - /spec/components
    # ocp/configure_quay_mirror rewrites this secret's config.yaml in-place to
    # add DISTRIBUTED_STORAGE_CONFIG (switching Quay off the NooBaa pv-pool,
    # which can't hold the full mirror payload — see that role for details).
    # Without this, selfHeal reverts it back to the repo's minimal config.yaml
    # on the next sync, wiping the storage backend out from under Quay.
    - group: ""
      kind: Secret
      name: init-config-bundle-secret
      jsonPointers:
        - /data
        - /stringData
