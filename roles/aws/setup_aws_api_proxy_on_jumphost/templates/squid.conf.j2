http_port {{ aws_api_proxy_port }}

acl SSL_ports port 443
acl Safe_ports port 443 80
acl CONNECT method CONNECT

acl aws_api_domains dstdomain {{ aws_api_proxy_allowed_domains | join(' ') }}

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow CONNECT aws_api_domains
http_access deny CONNECT
http_access allow aws_api_domains
http_access deny all

# No disk cache needed (and avoids requiring a writable cache dir in the
# container) — this proxy only tunnels AWS API calls, nothing cacheable.
cache deny all
coredump_dir /tmp
